# ALEM (эмбеддинги описаний и LLM) — скопировать из медицинского проекта
EMBED_API_KEY=
ALEM_API_KEY=
ALEM_URL=
EMBED_MODEL=text-1024

# Qdrant: пусто = встроенный режим без сервера; с docker compose — http://localhost:6333
QDRANT_URL=

# Трейсинг
TRACING=1                       # Phoenix: локальный дашборд на :6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=baga-ai
LANGSMITH_TRACING=true
