# Скопировать в .env. Без ключей LLM сайт работает: поиск, вердикт по цене, шаблонные ответы.

# ---- LLM: основная — Gemini 3.6 Flash через Vertex AI (express mode, ключ API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING=minimal               # подобрано A/B: minimal / low / medium (EVALS.md, раздел 6)
LLM_CHAIN=gemini,alem                 # порядок фолбэка
LLM_DAILY_BUDGET_USD=3                # превышен — платные модели пропускаются

# ---- ALEM: эмбеддинги описаний (text-1024) и фолбэк-LLM (alemllm)
ALEM_URL=
ALEM_API_KEY=
EMBED_API_KEY=
EMBED_MODEL=text-1024
ALEM_CHAT_MODEL=alemllm

# ---- Трейсинг: Langfuse (основной)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Phoenix — локально, без аккаунта (нужен pip install -r requirements-optional.txt)
TRACING=0
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# ---- Qdrant: пусто = встроенный режим без сервера; в docker compose задаётся сам
QDRANT_URL=

# ---- Пользователи
BAGA_ADMIN_USER=admin
BAGA_ADMIN_PASSWORD=                  # от 8 символов; админ создаётся при старте
ALLOW_SIGNUP=1                        # регистрация пользователей на сайте
RATE_LIMIT_USER=60                    # LLM-действий в час на пользователя

# ---- Telegram-бот
TELEGRAM_BOT_TOKEN=                   # у @BotFather
TELEGRAM_ADMIN_IDS=                   # chat id через запятую — без лимита

# ---- LoRA на текстовую башню SigLIP 2 (finetune_text_lora.py)
USE_TEXT_LORA=0
