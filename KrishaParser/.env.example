# Copy to .env and adjust. No secrets are required for scraping.

# --- Scraping politeness (hard limits; do not raise for speed) ---
KRISHA_MAX_CONCURRENCY=2
KRISHA_MIN_DELAY_MS=1500
KRISHA_MAX_DELAY_MS=6000
KRISHA_START_DELAY_MS=2500

# Realistic browser User-Agent used by the httpx engine.
KRISHA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# --- Playwright (detail pages) ---
KRISHA_PW_HEADLESS=1
# Optional private JSON list: [{"server":"http://host:port","username":"...","password":"..."}]
# Each configured route is used in order after block cooldown, within MAX_RETRIES.
# No proxy configured => direct connection. Store credentials only in ignored data/.
KRISHA_PROXIES_FILE=
# Zero-based start position, useful when previous endpoints have already failed.
KRISHA_PROXY_START_INDEX=0
# Windows WARP local proxy only: reconnect after blocks and optionally every N pages.
# Opt-in; requires WARP already installed, registered and in proxy mode on port 40000.
KRISHA_WARP_RECONNECT=0
KRISHA_WARP_ROTATE_EVERY=0

# --- Embeddings / Qdrant (Phase B) ---
# Local Docker: leave QDRANT_URL as-is and QDRANT_API_KEY empty.
# Qdrant Cloud: set QDRANT_URL to your cluster URL (…:6333) and QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=listing_photos
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
CLIP_DEVICE=cpu
